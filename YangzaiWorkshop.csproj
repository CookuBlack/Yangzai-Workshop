<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YangzaiWorkshop</AssemblyName>
    <ApplicationIcon>Assets\Icon\Yangzai.ico</ApplicationIcon>
    <AssemblyVersion>4.1.0.0</AssemblyVersion>
    <FileVersion>4.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.0.54" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="GaussYannin\DesktopPet.csproj" />
  </ItemGroup>

  <!-- 宠物模块已作为独立类库（DesktopPet）引用，从主项目默认编译项中排除，避免重复编译与命名冲突 -->
  <ItemGroup>
    <Compile Remove="GaussYannin\**\*.cs" />
    <Page Remove="GaussYannin\**\*.xaml" />
    <ApplicationDefinition Remove="GaussYannin\**\*.xaml" />
    <EmbeddedResource Remove="GaussYannin\**" />
    <None Remove="GaussYannin\**" />
    <Content Remove="GaussYannin\**" />
    <Resource Remove="GaussYannin\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Resource Include="Resources\Themes\*.xaml" />
    <Resource Include="Resources\Styles\*.xaml" />
  </ItemGroup>

</Project>
