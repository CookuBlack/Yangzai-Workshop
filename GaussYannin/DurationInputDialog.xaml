<Window x:Class="DesktopPet.DurationInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义工作时长"
        Width="280"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FBF3E4"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="请输入工作时长（分钟，1~120）"
                   Foreground="#6B5847"
                   FontSize="13"
                   Margin="0,0,0,10" />
        <TextBox x:Name="MinuteBox"
                 Width="120"
                 HorizontalAlignment="Left"
                 Text="25"
                 FontSize="14"
                 Foreground="#6B5847"
                 Padding="6,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定"
                    Width="72" Padding="0,5"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Background="#F2D6A8"
                    BorderThickness="0"
                    Foreground="#6B5847"
                    FontSize="13"
                    FontWeight="Bold"
                    Click="Ok_Click" />
            <Button Content="取消"
                    Width="72" Padding="0,5"
                    Cursor="Hand"
                    Background="#EFE3CF"
                    BorderThickness="0"
                    Foreground="#6B5847"
                    FontSize="13"
                    Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
