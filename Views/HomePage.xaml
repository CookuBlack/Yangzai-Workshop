<UserControl x:Class="YangzaiWorkshop.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <!-- 轮播区 : 下半区 ≈ 5 : 3，随窗口等比缩放 -->
            <RowDefinition Height="5*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <!-- ===== 轮播视频（RectangleGeometry 强裁圆角） ===== -->
        <Border x:Name="BannerWrapper" Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="0" CornerRadius="12"
                MouseRightButtonDown="Banner_MouseRightButtonDown">
            <Grid x:Name="BannerGrid"
                  SizeChanged="BannerGrid_SizeChanged"
                  Loaded="BannerGrid_Loaded">
                <MediaElement x:Name="BannerVideo2" LoadedBehavior="Manual"
                              UnloadedBehavior="Stop" Opacity="0"
                              Stretch="UniformToFill" ScrubbingEnabled="True"
                              RenderOptions.BitmapScalingMode="HighQuality"/>
                <MediaElement x:Name="BannerVideo" LoadedBehavior="Manual"
                              UnloadedBehavior="Stop"
                              Stretch="UniformToFill" ScrubbingEnabled="True"
                              RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- 轮播图片（与视频共用同一区域，按文件类型切换显隐） -->
                <Image x:Name="BannerImage2" Stretch="UniformToFill" Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="BannerImage" Stretch="UniformToFill" Opacity="0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="BannerPlaceholder" Text="&#xE714; 暂无轮播内容"
                           FontFamily="Microsoft YaHei UI" FontSize="16"
                           Foreground="{DynamicResource BorderBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="PrevButton" Content="&#xE76B;"
                        FontFamily="Segoe MDL2 Assets" FontSize="20"
                        Width="36" Height="36" Opacity="0.6"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Click="PrevBanner_Click"
                        Style="{StaticResource WindowControlButtonStyle}"/>
                <Button x:Name="NextButton" Content="&#xE76C;"
                        FontFamily="Segoe MDL2 Assets" FontSize="20"
                        Width="36" Height="36" Opacity="0.6"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="NextBanner_Click"
                        Style="{StaticResource WindowControlButtonStyle}"/>
                <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,16"/>
            </Grid>
        </Border>

        <!-- ===== 目录入口（左侧）+ 公告（右侧）===== -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：目录卡片 + 一键开始（一键开始板块底部对齐） -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 四个目录卡片 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- 根目录 -->
                    <Border x:Name="RootDirCard" Grid.Column="0"
                            Style="{StaticResource CardStyle}" Cursor="Hand" Padding="14,12"
                            Margin="0,0,6,0"
                            MouseLeftButtonDown="Card_MouseDown"
                            MouseLeftButtonUp="Card_MouseUp"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                    Background="#1A1976D2" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1976D2" BlurRadius="6" ShadowDepth="0" Opacity="0.18"/>
                                </Border.Effect>
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="19" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="根目录" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="访问工作根目录" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 图片目录 -->
                    <Border x:Name="ImageDirCard" Grid.Column="1"
                            Style="{StaticResource CardStyle}" Cursor="Hand" Padding="14,12"
                            Margin="2,0,2,0"
                            MouseLeftButtonDown="Card_MouseDown"
                            MouseLeftButtonUp="Card_MouseUp"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                    Background="#1A66BB6A" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#66BB6A" BlurRadius="6" ShadowDepth="0" Opacity="0.18"/>
                                </Border.Effect>
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="19" Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="图片目录" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="浏览素材图片" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 视频目录 -->
                    <Border x:Name="VideoDirCard" Grid.Column="2"
                            Style="{StaticResource CardStyle}" Cursor="Hand" Padding="14,12"
                            Margin="2,0,2,0"
                            MouseLeftButtonDown="Card_MouseDown"
                            MouseLeftButtonUp="Card_MouseUp"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                    Background="#1AFF7043" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF7043" BlurRadius="6" ShadowDepth="0" Opacity="0.18"/>
                                </Border.Effect>
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="19" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="视频目录" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="浏览视频素材" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 音频目录 -->
                    <Border x:Name="AudioDirCard" Grid.Column="3"
                            Style="{StaticResource CardStyle}" Cursor="Hand" Padding="14,12"
                            Margin="6,0,0,0"
                            MouseLeftButtonDown="Card_MouseDown"
                            MouseLeftButtonUp="Card_MouseUp"
                            MouseEnter="Card_MouseEnter"
                            MouseLeave="Card_MouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                    Background="#1AAB47BC" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#AB47BC" BlurRadius="6" ShadowDepth="0" Opacity="0.18"/>
                                </Border.Effect>
                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="19" Foreground="#CE93D8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="音频目录" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="浏览音频素材" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 一键开始 + GitHub（底部对齐） -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource CardBackgroundGradientStart}" Offset="0"/>
                            <GradientStop Color="{DynamicResource CardBackgroundGradientEnd}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="准备开始创作" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="NovelCountText" Text="已导入 0 本小说"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                            <!-- GitHub 项目链接 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="GitHubLink_Click"
                                        ToolTip="https://github.com/CookuBlack/Yangzai-Workshop">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="github.com/CookuBlack/Yangzai-Workshop"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextDecorations="Underline"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Click="StartButton_Click"
                                Background="#D9743B"
                                Foreground="White" BorderThickness="0"
                                FontSize="15" FontFamily="Microsoft YaHei UI"
                                Cursor="Hand" Padding="30,15"
                                VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#8A4A20" BlurRadius="10" ShadowDepth="0" Opacity="0.28"/>
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- 悬浮：不发亮，仅轻微加深以示可交互 -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="#C9662F"/>
                                                    </Trigger>
                                                    <!-- 按下：明显变暗 + 缩小，产生按压反馈 -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="#A84D1E"/>
                                                        <Setter TargetName="bd" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  一键开始" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右侧公告栏（顶部加渐变点 + 更好排版） -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 标题区：图标 + 标题 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="#1AFF7043" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF7043" BlurRadius="6" ShadowDepth="0" Opacity="0.18"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="公告" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="最新动态与更新说明" FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <!-- 分隔线 + 滚动公告 -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0" Opacity="0.5" Margin="0,0,0,12"/>
                        <ScrollViewer Grid.Row="1" x:Name="NoticeScroller"
                                      VerticalScrollBarVisibility="Hidden"
                                      PreviewMouseWheel="NoticeScroller_PreviewMouseWheel">
                            <TextBlock x:Name="NoticeText" Text="加载中..."
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" LineHeight="22"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
