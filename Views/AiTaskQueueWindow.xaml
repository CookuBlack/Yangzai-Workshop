<Window x:Class="YangzaiWorkshop.Views.AiTaskQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 任务队列" Width="640" Height="500"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#808080"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="🧹 清空已完成"
                    FontSize="11" Padding="12,4"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="ClearFinished_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📋 AI 任务队列" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="10,3,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- 任务列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TaskList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 类型图标 -->
                                <TextBlock Grid.Column="0" FontSize="18" Text="🖼️"
                                           VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🖼️"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Video">
                                                    <Setter Property="Text" Value="🎬"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Prompt}" FontSize="12.5"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="300"
                                               ToolTip="{Binding Prompt}"/>
                                    <TextBlock FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,3,0,0">
                                        <Run Text="{Binding NovelName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ScopeName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                                    </TextBlock>
                                    <!-- 耗时显示（任务结束后出现，绿色高亮） -->
                                    <TextBlock Text="{Binding DurationText}" FontSize="10.5"
                                               Foreground="#2E7D32" FontWeight="Medium"
                                               Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DurationText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 状态徽章 -->
                                <Border Grid.Column="2" Margin="12,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Queued">
                                                    <Setter Property="Background" Value="#8A6D3B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Background" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Background" Value="#C62828"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#757575"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5" Foreground="White"
                                               TextAlignment="Center"/>
                                </Border>

                                <!-- 取消按钮 -->
                                <Button Grid.Column="3" Content="取消" FontSize="10.5"
                                        Padding="8,2" Margin="4,0,0,0"
                                        Click="CancelTask_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="4" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="任务在后台串行执行，关闭此窗口或离开页面不会中断。完成或失败时会通过主窗口底部通知提醒您。"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
