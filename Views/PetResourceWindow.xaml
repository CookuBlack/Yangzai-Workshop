<Window x:Class="YangzaiWorkshop.Views.PetResourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宠物资源管理" Width="760" Height="560"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="📂 打开文件夹"
                        FontSize="11" Padding="12,4" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="OpenFolder_Click"/>
                <Button Content="🔄 刷新"
                        FontSize="11" Padding="12,4"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="Refresh_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🐾 宠物资源管理" FontSize="15" FontWeight="SemiBold"/>
                <ComboBox x:Name="FilterBox" Width="90" Height="26" FontSize="12"
                          Margin="12,0,0,0" VerticalAlignment="Center"
                          SelectionChanged="FilterBox_SelectionChanged"/>
                <TextBlock x:Name="CountText" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="10,3,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- 资源内容区（瀑布流/卡片） -->
        <ScrollViewer x:Name="ContentScroller" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ResourceGrid" Margin="0,0,0,0"/>
        </ScrollViewer>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="4" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="宠物通过 AI 功能生成的图片、视频以及对话文本都会保存到这里。点击图片直接预览，视频点击播放。"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
