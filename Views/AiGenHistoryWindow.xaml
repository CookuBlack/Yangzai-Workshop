<Window x:Class="YangzaiWorkshop.Views.AiGenHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录" Width="560" Height="440"
        MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="历史记录"/>
            <TextBlock x:Name="CountText" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ListView x:Name="HistoryList" Grid.Row="2"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  SelectionChanged="List_SelectionChanged"
                  MouseDoubleClick="List_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource BorderBrush}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="{DynamicResource PrimaryLowBrush}"
                                    CornerRadius="10" Padding="6,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center" ToolTip="参考素材数量">
                                <TextBlock Text="{Binding Summary}"
                                           FontSize="10" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding TypeText}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="10"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Prompt}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" MaxHeight="40"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🗑 清除历史" FontSize="12" Padding="14,5" Margin="0,0,8,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="ClearHistory_Click"
                    ToolTip="删除全部 AI 生成历史记录（图片与视频）"/>
            <TextBlock x:Name="SelectedText" FontSize="11" Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" Text="点击选择一条记录"/>
            <Button Content="取消" FontSize="12" Padding="16,5" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button Content="使用该记录填充" FontSize="12" Padding="16,5"
                    Style="{DynamicResource PrimaryButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>