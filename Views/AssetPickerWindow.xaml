<Window x:Class="YangzaiWorkshop.Views.AssetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择项目图片" Width="680" Height="520"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题与说明 -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Text="选择项目中的图片"/>
            <TextBlock x:Name="HintText" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="点击选择一张图片作为参考图，双击或点击“使用此图”确认。"/>
        </StackPanel>

        <!-- 图片网格 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="AssetPanel"/>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SelectedText" FontSize="11" Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="未选择"/>
            <Button Content="取消" FontSize="12" Padding="16,5" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Content="使用此图" FontSize="12" Padding="16,5"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
