<Window x:Class="YangzaiWorkshop.Views.AiApiConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 接口配置" Width="820" Height="740"
        MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="ApiFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ApiSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <!-- 默认生图引擎选择胶囊按钮 -->
        <Style x:Key="EnginePillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="16" Padding="15,6" BorderThickness="1.5"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,8,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource PrimaryLowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 深色模式下自适应主题的 Tab 控件（修复默认样式黑字/白底问题） -->
        <Style x:Key="ApiTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="4">
                                <TabPanel IsItemsHost="True" Margin="2"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ApiTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" CornerRadius="7" Padding="15,7" Margin="2,1"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource PrimaryLowBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 工作流列表项 -->
        <DataTemplate x:Key="WorkflowItemTemplate">
            <Border Background="Transparent" Padding="4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 来源徽章 -->
                    <Border Grid.Column="0" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PrimaryLowBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source}" Value="BuiltIn">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="9.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="用户导入"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="BuiltIn">
                                            <Setter Property="Text" Value="内置"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DefaultBadge" FontSize="9" Margin="8,1,0,0"
                                       Foreground="#C62828" FontWeight="Bold" Text="● 默认"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ParamsText" FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding ParamsSummary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- 当前选中标记 -->
                    <TextBlock Grid.Column="2" Text="✓" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 标题 -->
            <RowDefinition Height="14"/>     <!-- 1 间距 -->
            <RowDefinition Height="*"/>      <!-- 2 配置 Tab 区 -->
            <RowDefinition Height="12"/>     <!-- 3 间距 -->
            <RowDefinition Height="Auto"/>   <!-- 4 底部按钮区 -->
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{DynamicResource PrimaryBrush}">
                    <TextBlock Text="🔌" FontSize="19" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AI 接口配置" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="文本 / 图片 / 视频接口各自独立，可分别使用不同服务商与模型" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Tab 配置区 -->
        <TabControl x:Name="MainTabs" Grid.Row="2" FontSize="12"
                    Style="{StaticResource ApiTabControlStyle}"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="💬  文本对话" Style="{StaticResource ApiTabItemStyle}">
                <Grid x:Name="TextTabHost"/>
            </TabItem>

            <TabItem Header="🖼️  图片生成" Style="{StaticResource ApiTabItemStyle}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 生图引擎选择 -->
                        <RowDefinition Height="*"/>      <!-- 对应配置 -->
                    </Grid.RowDefinitions>

                    <!-- 生图引擎选择：云端 API / 本地 ComfyUI（决定下方展示哪套配置） -->
                    <Border Grid.Row="0" Style="{StaticResource ApiSectionCard}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="默认生图引擎" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ProviderApiRadio" GroupName="ImageProvider"
                                             Tag="Api" Style="{StaticResource EnginePillRadio}"
                                             Checked="ProviderRadio_Checked">
                                    <TextBlock Text="☁️ 云端 API" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </RadioButton>
                                <RadioButton x:Name="ProviderComfyRadio" GroupName="ImageProvider"
                                             Tag="ComfyUI" Style="{StaticResource EnginePillRadio}"
                                             Checked="ProviderRadio_Checked">
                                    <TextBlock Text="🖥️ 本地 ComfyUI" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </RadioButton>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 云端 API 图片配置表单（代码构建） -->
                    <Grid x:Name="ImageTabHost" Grid.Row="1" Margin="0,14,0,0"/>

                    <!-- 本地 ComfyUI 配置（依据引擎选择展示） -->
                    <Grid x:Name="ComfyUiHost" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- ComfyUI 服务 -->
                                <Border Style="{StaticResource ApiSectionCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10">🖥️ ComfyUI 服务</TextBlock>
                                        <TextBlock Style="{StaticResource ApiFieldLabel}" Text="服务地址"/>
                                        <TextBox x:Name="ComfyEndpointBox" Style="{StaticResource ModernTextBoxStyle}"
                                                 FontSize="12" ToolTip="例如 http://127.0.0.1:8188"/>
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="启动 ComfyUI 后在浏览器打开（默认 http://127.0.0.1:8188），把 API 地址填到这里即可。"/>
                                    </StackPanel>
                                </Border>

                                <!-- 工作流管理 -->
                                <Border Style="{StaticResource ApiSectionCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold">📄 工作流管理</TextBlock>
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Text="从 ComfyUI 网页右键「Export (API)」导出 JSON 后导入；也可以把默认工作流 JSON 直接放到工作流目录（点击「打开目录」）。保存后可自动解析并调整模型/LoRA/采样参数。"/>

                                        <ListBox x:Name="WorkflowList" Margin="0,10,0,0" MinHeight="120"
                                                 MaxHeight="240" SelectionMode="Single"
                                                 ItemTemplate="{StaticResource WorkflowItemTemplate}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 Background="{DynamicResource WindowBackgroundBrush}"
                                                 SelectionChanged="WorkflowList_SelectionChanged"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                                        <!-- 操作按钮 -->
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="ImportWorkflowBtn" Content="📥 导入工作流" FontSize="11" Padding="12,5"
                                                    Margin="0,0,8,8" Style="{DynamicResource PrimaryButtonStyle}"
                                                    Click="ImportWorkflow_Click"/>
                                            <Button x:Name="SetDefaultBtn" Content="✅ 设为默认" FontSize="11" Padding="12,5"
                                                    Margin="0,0,8,8" Style="{DynamicResource SecondaryButtonStyle}"
                                                    IsEnabled="False" Click="SetDefault_Click"/>
                                            <Button x:Name="EditParamsBtn" Content="⚙️ 编辑参数" FontSize="11" Padding="12,5"
                                                    Margin="0,0,8,8" Style="{DynamicResource SecondaryButtonStyle}"
                                                    IsEnabled="False" Click="EditParams_Click"/>
                                            <Button x:Name="ReparseBtn" Content="🔄 重新解析" FontSize="11" Padding="12,5"
                                                    Margin="0,0,8,8" Style="{DynamicResource SecondaryButtonStyle}"
                                                    IsEnabled="False" Click="Reparse_Click"/>
                                            <Button x:Name="DeleteWorkflowBtn" Content="🗑 删除" FontSize="11" Padding="12,5"
                                                    Margin="0,0,8,8" Style="{DynamicResource SecondaryButtonStyle}"
                                                    IsEnabled="False" Click="DeleteWorkflow_Click"/>
                                            <Button Content="📂 打开目录" FontSize="11" Padding="12,5"
                                                    Margin="0,0,0,8" Style="{DynamicResource SecondaryButtonStyle}"
                                                    Click="OpenWorkflowDir_Click"/>
                                        </WrapPanel>

                                        <TextBlock x:Name="WorkflowDirHint" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🎬  视频生成" Style="{StaticResource ApiTabItemStyle}">
                <Grid x:Name="VideoTabHost"/>
            </TabItem>
        </TabControl>

        <!-- 底部：恢复默认（左下） + 提示 + 取消 / 保存 -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="6,12,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="🔄 恢复默认" FontSize="11" Padding="14,6"
                        VerticalAlignment="Center"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="ResetDefaults_Click"/>
                <TextBlock Grid.Column="1" x:Name="SaveHintText" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="16,0,16,0"
                           Text="各通道独立配置：服务商预设自动填充地址与推荐模型；模型能力提示随选择实时更新"/>
                <Button Grid.Column="2" Content="取消" FontSize="12" Padding="18,6" Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button Grid.Column="3" Content="💾 保存配置" FontSize="12" Padding="18,6"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
