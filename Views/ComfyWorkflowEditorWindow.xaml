<Window x:Class="YangzaiWorkshop.Views.ComfyWorkflowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作流参数编辑" Width="760" Height="720"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10"
                        Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="17" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="工作流参数编辑" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WorkflowNameText" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                </StackPanel>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="🔄 重新解析" FontSize="11" Padding="12,5"
                    VerticalAlignment="Center"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    ToolTip="从工作流文件重新读取节点参数，覆盖当前编辑内容"
                    Click="Reparse_Click"/>
        </DockPanel>

        <!-- 可滚动编辑区 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 模型 / LoRA / CLIP / VAE -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">📦 模型与附加模块</TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="基础模型 (Checkpoint)"/>
                                <TextBox x:Name="CheckpointBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12" ToolTip="CheckpointLoaderSimple 的 ckpt_name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="VAE 名称"/>
                                <TextBox x:Name="VaeBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12" ToolTip="VAELoader 的 vae_name"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="LoRA 名称"/>
                                <TextBox x:Name="LoraBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12" ToolTip="LoraLoader 的 lora_name，无则留空"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="LoRA 权重"/>
                                <DockPanel>
                                    <TextBlock x:Name="LoraStrengthText" DockPanel.Dock="Right" Width="42"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="LoraStrengthSlider" Minimum="0" Maximum="2"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            ValueChanged="LoraStrengthSlider_ValueChanged"
                                            VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CLIP 名称"/>
                                <TextBox x:Name="ClipBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12" ToolTip="CLIPLoader 的 clip_name，无则留空"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="图像尺寸 (宽 × 高)"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WidthBox" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}"
                                             FontSize="12" ToolTip="EmptyLatentImage 的 width"/>
                                    <TextBlock Grid.Column="1" Text="×" FontSize="12" Margin="6,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="HeightBox" Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}"
                                             FontSize="12" ToolTip="EmptyLatentImage 的 height"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 采样参数 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">🎛️ KSampler 采样参数</TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="采样算法 (Sampler)"/>
                                <ComboBox x:Name="SamplerBox" Style="{StaticResource ModernComboBoxStyle}"
                                          FontSize="12" MinHeight="28"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="调度器 (Scheduler)"/>
                                <ComboBox x:Name="SchedulerBox" Style="{StaticResource ModernComboBoxStyle}"
                                          FontSize="12" MinHeight="28"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="采样步数 (Steps)"/>
                                <TextBox x:Name="StepsBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CFG 引导强度"/>
                                <TextBox x:Name="CfgBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="重绘幅度 (Denoise)"/>
                                <TextBox x:Name="DenoiseBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="随机种子 (Seed, -1=随机)"/>
                                <TextBox x:Name="SeedBox" Style="{StaticResource ModernTextBoxStyle}"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text=""/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 提示词 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">✍️ 提示词（默认值，生图时正向提示词会被输入覆盖）</TextBlock>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="正向提示词"/>
                        <TextBox x:Name="PositivePromptBox" Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12" MinHeight="70" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="负向提示词" Margin="0,10,0,4"/>
                        <TextBox x:Name="NegativePromptBox" Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12" MinHeight="54" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="4,12,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="SaveHintText" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="保存后参数会写回工作流文件，下次生成时自动生效"/>
                <Button Grid.Column="1" Content="取消" FontSize="12" Padding="18,6" Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="💾 保存参数" FontSize="12" Padding="18,6"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
